# ─────────────────────────────────────────────────────────────────────────
# kJubilee — environment configuration TEMPLATE
# Copy to `.env` (gitignored) and fill in the real values per environment.
# ─────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3210
SITE_NAME=kJubilee
SITE_DOMAIN=kjubilee.com

# ── Postgres (kJubilee has a dedicated DB; see migrations/) ──────────────
# In dev with no DB yet, the app boots but DB-backed routes return 503.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kjubilee
DB_USER=postgres
DB_PASSWORD=

# ── Session tokens (minted by this server, held by the browser) ──────────
# REQUIRED in production — generate with: openssl rand -hex 64
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d
# Lifetime when "Keep me signed in on this device" is left OFF at the door.
# ── Sessions: a short access token, a revocable refresh token ────────────
# The access token is stateless and checked by signature alone, so it is kept
# SHORT — a stolen one expires on its own. The refresh token is the long-lived
# half, stored in kj_sessions as a hash, and is what sign-out revokes.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Session length when "Keep me signed in on this device" is left OFF.
SESSION_HOURS=12

# ── Jubilee ID (SSO) — the identity authority for the whole family ───────
# One Jubilee ID works across every Jubilee site, and it is the SOLE store of
# a person's password: kJubilee keeps no password for a Jubilee ID account.
# See lib/sso.js and the /api/sso/* routes in server.js.
#
# SSO_CLIENT_SECRET must be provisioned by the authority for the client_id
# below — kJubilee needs its own registered client, it cannot borrow another
# site's. Leave the secret EMPTY and the door falls back to this site's own
# kj_users password, which is how a dev box with no credentials still works
# and how accounts created before the door keep signing in.
SSO_BASE=https://sso.jubileeinspire.com
SSO_CLIENT_ID=kjubilee
SSO_CLIENT_SECRET=
SSO_SITE=kjubilee
SSO_TIMEOUT_MS=10000

# ── Sign-in rate limit (stricter than the global one) ────────────────────
# The global limiter is sized for a player fetching schedules; password
# attempts get their own, much smaller budget.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# ── CDN (where the audio assets live) ────────────────────────────────────
# kJubilee reuses JubileeVerse's existing Cloudflare R2 bucket at
# cdn.jubileeverse.com (no separate bucket required). The player URLs are
# hard-coded to that host; in dev they get rewritten to /cdn/<path> and
# served from CDN_LOCAL_ROOT below.
# The tree has two branches: `music/` (audio, served as /cdn/music/*) and
# `radio/<STATION_ID>/delivery/*.json` (station manifests, /cdn/radio/*).
CDN_LOCAL_ROOT=
PUBLIC_CDN_URL=https://cdn.jubileeverse.com

# ── Streaming engine (Icecast) — external service, see docs/Radio-Engine-Spec.md ─
# kJubilee's player reads streams from https://radio.kjubilee.com/stream/<format>
PUBLIC_STREAM_BASE=https://radio.kjubilee.com

# ── Cloudflare R2 (audio object storage) — used by scripts/r2-sync-music.js ─
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kjubilee-music

# ── Rate limiting (per IP) ───────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ── Outbound email (Mailgun) ─────────────────────────────────────────────
# The DNS for kjubilee.com is in Cloudflare and checks out:
#   SPF      v=spf1 include:mailgun.org ~all
#   DKIM     krs._domainkey.kjubilee.com   (2048-bit)
#   tracking email.kjubilee.com CNAME mailgun.org
#   DMARC    p=reject
#   MX       none — no mailbox to conflict with
#
# ⚠ DMARC is p=reject, so EMAIL_FROM MUST stay on kjubilee.com. A message sent
# from @jubileeinspire.com through this domain is not just unaligned — receivers
# are being told to discard it. That is the mistake TorahSings shipped.
#
# Leave MAILGUN_API_KEY empty and lib/email.js falls back to a dev transport
# that LOGS the message instead of sending it, so the reset flow can be walked
# end to end on a box with no key.
# Use the Mailgun SENDING key (not the SMTP password, and not an account key).
# This transport speaks the HTTP API; the SMTP credentials on the same Mailgun
# domain are for an SMTP client and are unused here.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=kjubilee.com
# US region. EU accounts use https://api.eu.mailgun.net.
MAILGUN_API_BASE=https://api.mailgun.net
# true = Mailgun accepts and logs the message but delivers it to nobody. Set it
# on staging so the reset flow can be walked without mailing real people.
EMAIL_TEST_MODE=false
EMAIL_FROM=kJubilee <noreply@kjubilee.com>

# Absolute base for links inside emails. Must be the public origin, not localhost,
# or the reset link in a real message points at the sender's own machine.
PUBLIC_SITE_URL=https://kjubilee.com

# ── Password reset ───────────────────────────────────────────────────────
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_MAX_LIVE=3

# ── Human verification (Cloudflare Turnstile) ────────────────────────────
# The site key is public and is rendered into the page; the SECRET key is
# server-only and must never be given a NEXT_PUBLIC_ name or it ships to the
# browser and stops being a secret.
#
# ⚠ The widget only paints on a hostname in this site key's Cloudflare
# allowlist. kjubilee.com, www.kjubilee.com AND localhost all need to be on it —
# otherwise no token is ever produced and, with enforcement on, nobody can sign
# in. TURNSTILE_ENFORCE=false keeps the widget visible but stops gating on it,
# which is the escape hatch for a box in that state.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENFORCE=true
TURNSTILE_TIMEOUT_MS=8000

# ── Where the browser sends API calls ────────────────────────────────────
# Empty = same-origin, which is the default and costs no CORS preflight.
# Set to https://api.kjubilee.com to use the dedicated auth API host.
# ⚠ NEXT_PUBLIC_ is inlined at BUILD time — changing it needs `npm run build`.
NEXT_PUBLIC_API_BASE=

# Extra browser origins allowed to call the API, comma-separated and exact.
# The Jubilee family and localhost are already allowed (lib/cors.js).
CORS_ORIGINS=
