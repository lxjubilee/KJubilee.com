node_modules
.env*
!.env.example
*.log

# IDE / OS
.idea/
.vscode/
.DS_Store
desktop.ini
Thumbs.db

# Runtime artifacts
*.pid
run/
nul
logs/

# CDN local content (large audio files; mirrors the production R2 bucket)
cdn/
public/audio/

# Large media types should never end up in git
*.mp3
*.mp4
*.m4a
*.ogg
*.webm

# Throwaway debug scripts (may contain local credentials)
tmp/

# Test artifacts
test-results/
coverage/

# Python bytecode. tools/music-ingest and tools/scripture are run in place, so
# the interpreter drops these beside the sources every time; one was committed
# before this rule existed and is untracked by the same commit that adds it.
__pycache__/
*.py[cod]

# Station Image Studio (WPF): build output and local config
tools/StationImageStudio/bin/
tools/StationImageStudio/obj/
tools/StationImageStudio/studio.config.json

# Next.js
.next/
# Any NEXT_DIST_DIR escape hatch, not just the dev one. This checkout is on an
# SMB share that keeps handles open on a killed build's traced node_modules, so
# a stuck output directory cannot be deleted and the way forward is a fresh
# name — see the distDir note in next.config.js. Those are all build output.
.next-*/
# The parking bay for those directories once they are finished with. Same
# reason they cannot simply be deleted - a killed build leaves handles open
# on the share - so they are renamed out of the way instead, and one
# ignore covers every naming scheme they have collected (.next.old-*,
# .next.stale-*, .next.locked-*), none of which .next-*/ above matches.
.temp/
next-env.d.ts
